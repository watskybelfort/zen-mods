<#
.SYNOPSIS
    Utilidades compartidas por Install-AcrylicZen.ps1 y Uninstall-AcrylicZen.ps1.
#>

function Write-Utf8NoBom {
    <#
    .SYNOPSIS
        Escribe texto en UTF-8 sin BOM.
    .DESCRIPTION
        Out-File y Set-Content de PowerShell 5.1 meten BOM. IOUtils.readJSON de
        Gecko hace JSON.parse directo sobre el texto, y un BOM lo revienta.
    #>
    param([Parameter(Mandatory)] [string] $Path, [Parameter(Mandatory)] [AllowEmptyString()] [string] $Content)
    $enc = New-Object System.Text.UTF8Encoding($false)
    [System.IO.File]::WriteAllText($Path, $Content, $enc)
}

function ConvertTo-OrderedHashtable {
    <#
    .SYNOPSIS
        PSCustomObject -> [ordered]@{}. ConvertFrom-Json -AsHashtable no existe en 5.1.
    #>
    param($Object)
    $ht = [ordered]@{}
    if ($null -eq $Object) { return $ht }
    foreach ($prop in $Object.PSObject.Properties) { $ht[$prop.Name] = $prop.Value }
    return $ht
}

function Resolve-ZenProfile {
    <#
    .SYNOPSIS
        Devuelve la ruta del perfil por defecto de Zen Browser.
    .DESCRIPTION
        Da prioridad a la seccion [Install<hash>] de profiles.ini: cuando hay
        varios perfiles, esa es la que dice cual abre realmente este ejecutable,
        por encima del Default=1 de las secciones [ProfileN].
    #>
    param([string] $Root = (Join-Path $env:APPDATA 'zen'))

    $ini = Join-Path $Root 'profiles.ini'
    if (-not (Test-Path $ini)) {
        throw "No se encontro profiles.ini en $Root. Zen Browser no parece instalado para este usuario."
    }

    $section = ''
    $installDefault = $null
    $flaggedDefault = $null
    $currentPath = $null
    $currentIsDefault = $false

    foreach ($raw in (Get-Content $ini -Encoding UTF8)) {
        $line = $raw.Trim()
        if ($line -match '^\[(.+)\]$') {
            if ($currentIsDefault -and $currentPath) { $flaggedDefault = $currentPath }
            $section = $Matches[1]
            $currentPath = $null
            $currentIsDefault = $false
            continue
        }
        if ($line -match '^Path=(.+)$') { $currentPath = $Matches[1] }
        if ($line -match '^Default=(.+)$') {
            if ($section -like 'Install*') { $installDefault = $Matches[1] }
            elseif ($Matches[1] -eq '1') { $currentIsDefault = $true }
        }
    }
    if ($currentIsDefault -and $currentPath) { $flaggedDefault = $currentPath }

    $rel = $installDefault
    if (-not $rel) { $rel = $flaggedDefault }
    if (-not $rel) { throw "No se pudo determinar el perfil por defecto en $ini." }

    $path = Join-Path $Root ($rel -replace '/', '\')
    if (-not (Test-Path $path)) { throw "El perfil declarado en profiles.ini no existe: $path" }
    return $path
}

function Assert-ZenClosed {
    <#
    .SYNOPSIS
        Falla si Zen esta abierto.
    .DESCRIPTION
        Zen reescribe prefs.js entero al salir, asi que cualquier pref que
        escribamos con el navegador abierto se perderia al cerrarlo.
    #>
    $running = Get-Process -Name 'zen' -ErrorAction SilentlyContinue
    if ($running) {
        throw "Zen Browser esta abierto (PID $($running.Id -join ', ')). Cierralo del todo y vuelve a ejecutar."
    }
}

function Update-ZenModsStylesheet {
    <#
    .SYNOPSIS
        Recompila <perfil>\chrome\zen-themes.css a partir de zen-themes.json.
    .DESCRIPTION
        Zen concatena los mods en ese archivo, pero solo lo regenera cuando algo
        toca la pref zen.mods.updated-value-observer (es decir, desde su propia
        interfaz) o tras la comprobacion periodica de actualizaciones. Al
        instalar un mod a mano el archivo se queda como estaba y el CSS nunca
        llega a aplicarse.

        Esto reproduce el formato de nsZenMods.#writeStylesheet para que el mod
        funcione desde el primer arranque. Cuando Zen lo regenere por su cuenta
        el resultado sera equivalente, porque lee la misma fuente.
    #>
    param([Parameter(Mandatory)] [string] $ProfilePath)

    $themesFile = Join-Path $ProfilePath 'zen-themes.json'
    $modsRoot = Join-Path $ProfilePath 'chrome\zen-themes'
    $outFile = Join-Path $ProfilePath 'chrome\zen-themes.css'

    $mods = [ordered]@{}
    if (Test-Path $themesFile) {
        $raw = (Get-Content $themesFile -Raw -Encoding UTF8).Trim()
        if ($raw) { $mods = ConvertTo-OrderedHashtable (ConvertFrom-Json $raw) }
    }

    $stamp = (Get-Date).ToString('dddd, MMMM d, yyyy \a\t h:mm:ss tt', [System.Globalization.CultureInfo]::GetCultureInfo('en-US'))

    $sb = New-Object System.Text.StringBuilder
    [void]$sb.Append("/* Zen Mods - Generated by ZenMods.")
    [void]$sb.Append("`n* FILE GENERATED AT: $stamp`n")
    [void]$sb.Append("* DO NOT EDIT THIS FILE DIRECTLY!`n")
    [void]$sb.Append("* Your changes will be overwritten.`n")
    [void]$sb.Append("* Instead, go to the preferences and edit the mods there.`n")
    [void]$sb.Append("*/`n")

    $count = 0
    foreach ($id in $mods.Keys) {
        $mod = $mods[$id]
        if ($null -eq $mod) { continue }
        if ($null -ne $mod.enabled -and -not $mod.enabled) { continue }

        $css = Join-Path (Join-Path $modsRoot $id) 'chrome.css'
        if (-not (Test-Path $css)) {
            Write-Warning "El mod '$id' esta registrado pero le falta chrome.css; se omite."
            continue
        }

        [void]$sb.Append("`n/* Name: $($mod.name) */`n")
        [void]$sb.Append("/* Description: $($mod.description) */`n")
        [void]$sb.Append("/* Author: @$($mod.author) */`n")
        [void]$sb.Append((Get-Content $css -Raw -Encoding UTF8))
        $count++
    }

    [void]$sb.Append("`n/* End of Zen Mods */`n")

    New-Item -ItemType Directory -Path (Split-Path -Parent $outFile) -Force | Out-Null
    Write-Utf8NoBom $outFile $sb.ToString()
    return $count
}

function Build-UserContentCss {
    <#
    .SYNOPSIS
        Genera <perfil>\chrome\userContent.css a partir de los parciales de web\.
    .DESCRIPTION
        El nivel se elige al generar el archivo y no con un interruptor del mod,
        pero no porque userContent.css no pueda leer opciones: SI puede leer las
        de tipo checkbox, que es una pref, porque es hoja de usuario y eso le
        basta a `-moz-pref` (lo hace el interruptor del buscador de YouTube).
        Lo que no llega a la pagina son los otros dos tipos: un desplegable
        escribe un atributo en un <div> del marco y una cadena una variable en
        su raiz, y ni el div ni la raiz del marco existen dentro del documento.
        El nivel es de esos: elige QUE parciales entran, asi que se decide aqui.

        Orden de concatenacion: base, contenedores (si procede), agresivo (si
        procede), ajustes por sitio y exclusiones al final. Las exclusiones van
        las ultimas a proposito: a igual especificidad gana la ultima regla, asi
        que siempre pueden devolver el fondo solido.
    .PARAMETER Level
        safe       solo html/body
        full       + contenedores raiz de frameworks (por defecto)
        aggressive + primeros descendientes del body
    #>
    param(
        [Parameter(Mandatory)] [string] $ProfilePath,
        [Parameter(Mandatory)] [string] $WebSource,
        [ValidateSet('safe', 'full', 'aggressive')] [string] $Level = 'full'
    )

    $parts = @('00-base.css')
    if ($Level -in @('full', 'aggressive')) { $parts += '10-wrappers.css' }
    if ($Level -eq 'aggressive') { $parts += '20-aggressive.css' }
    $parts += @('50-sites.css', '90-exclusions.css')

    $stamp = Get-Date -Format 'yyyy-MM-dd HH:mm:ss'
    $sb = New-Object System.Text.StringBuilder
    [void]$sb.Append("/* Acrylic Web - generado por Install-AcrylicZen.ps1`n")
    [void]$sb.Append(" * NIVEL: $Level`n")
    [void]$sb.Append(" * FECHA: $stamp`n")
    [void]$sb.Append(" *`n")
    [void]$sb.Append(" * No edites este archivo: se regenera en cada instalacion.`n")
    [void]$sb.Append(" * Edita los parciales de web\ y vuelve a ejecutar el instalador.`n")
    [void]$sb.Append(" */`n")

    foreach ($p in $parts) {
        $file = Join-Path $WebSource $p
        if (-not (Test-Path $file)) { throw "Falta el parcial $file" }
        [void]$sb.Append("`n/* ===== $p ===== */`n")
        [void]$sb.Append((Get-Content $file -Raw -Encoding UTF8))
    }

    $outFile = Join-Path $ProfilePath 'chrome\userContent.css'
    New-Item -ItemType Directory -Path (Split-Path -Parent $outFile) -Force | Out-Null
    Write-Utf8NoBom $outFile $sb.ToString()
    return $parts.Count
}

function Read-UserPrefFile {
    <#
    .SYNOPSIS
        Parsea un archivo estilo user.js a [ordered]@{ nombre = 'literal js' }.
    #>
    param([Parameter(Mandatory)] [string] $Path)
    $prefs = [ordered]@{}
    foreach ($line in (Get-Content $Path -Encoding UTF8)) {
        if ($line -match '^\s*user_pref\(\s*"([^"]+)"\s*,\s*(.+?)\s*\)\s*;\s*$') {
            $prefs[$Matches[1]] = $Matches[2]
        }
    }
    return $prefs
}

function Get-ZenModDefaultPrefs {
    <#
    .SYNOPSIS
        Convierte preferences.json de un mod en prefs con su valor por defecto.
    .DESCRIPTION
        nsZenMods.#setDefaults solo corre cuando Zen regenera la hoja de mods, no
        en el arranque. Sin sembrar estos valores, en el primer arranque los
        checkbox estarian sin definir (= false para @media -moz-pref) y el mod
        arrancaria con la mitad de sus opciones apagadas.
    #>
    param([Parameter(Mandatory)] [string] $PreferencesJsonPath)

    $prefs = [ordered]@{}
    if (-not (Test-Path $PreferencesJsonPath)) { return $prefs }

    foreach ($entry in (ConvertFrom-Json (Get-Content $PreferencesJsonPath -Raw -Encoding UTF8))) {
        if ($null -eq $entry.defaultValue) { continue }
        if ($entry.type -eq 'checkbox') {
            $prefs[$entry.property] = if ($entry.defaultValue) { 'true' } else { 'false' }
        }
        else {
            $prefs[$entry.property] = '"' + $entry.defaultValue + '"'
        }
    }
    return $prefs
}

function Set-ZenPrefs {
    <#
    .SYNOPSIS
        Escribe/actualiza lineas user_pref en prefs.js o user.js.
    #>
    param(
        [Parameter(Mandatory)] [string] $Path,
        [Parameter(Mandatory)] $Prefs,
        [string] $Marker = '// --- Acrylic Zen ---'
    )

    $existing = @()
    if (Test-Path $Path) { $existing = Get-Content $Path -Encoding UTF8 }

    $names = @($Prefs.Keys)
    $kept = @()
    foreach ($line in $existing) {
        if ($line -eq $Marker) { continue }
        $drop = $false
        foreach ($n in $names) {
            if ($line -match ('^\s*user_pref\(\s*"' + [regex]::Escape($n) + '"')) { $drop = $true; break }
        }
        if (-not $drop) { $kept += $line }
    }

    $block = @('', $Marker)
    foreach ($n in $names) { $block += ('user_pref("{0}", {1});' -f $n, $Prefs[$n]) }

    Write-Utf8NoBom $Path ((($kept + $block) -join "`r`n").TrimEnd() + "`r`n")
    return $names.Count
}

function Remove-ZenPrefs {
    <#
    .SYNOPSIS
        Borra lineas user_pref por nombre (vuelven a su valor por defecto).
    #>
    param(
        [Parameter(Mandatory)] [string] $Path,
        [Parameter(Mandatory)] [string[]] $Names,
        [string] $Marker = '// --- Acrylic Zen ---'
    )

    if (-not (Test-Path $Path)) { return 0 }

    $removed = 0
    $kept = @()
    foreach ($line in (Get-Content $Path -Encoding UTF8)) {
        if ($line -eq $Marker) { continue }
        $drop = $false
        foreach ($n in $Names) {
            if ($line -match ('^\s*user_pref\(\s*"' + [regex]::Escape($n) + '"')) { $drop = $true; break }
        }
        if ($drop) { $removed++ } else { $kept += $line }
    }

    Write-Utf8NoBom $Path ((($kept -join "`r`n").TrimEnd()) + "`r`n")
    return $removed
}

Export-ModuleMember -Function Write-Utf8NoBom, ConvertTo-OrderedHashtable, Resolve-ZenProfile,
Assert-ZenClosed, Update-ZenModsStylesheet, Build-UserContentCss, Read-UserPrefFile,
Get-ZenModDefaultPrefs, Set-ZenPrefs, Remove-ZenPrefs
